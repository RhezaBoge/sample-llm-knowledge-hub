# Copy this file to .env and change what you need:   cp .env.example .env

# ---------------------------------------------------------------------------
# AI model - any "OpenAI-compatible" API works
# ---------------------------------------------------------------------------

# Option A (default): Ollama inside Docker. Free, private, no account needed.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=

# Runs on CPU only - no GPU needed. Choose by your computer's memory:
#   LLM_MODEL=qwen2.5:1.5b   ~4 GB RAM, fastest, basic quality
#   LLM_MODEL=qwen2.5:3b     ~8 GB RAM (default)
#   LLM_MODEL=qwen2.5:7b     ~16 GB RAM, best quality

# Option B: the Ollama desktop app on your own computer (a bit faster on a Mac,
# because it can use the Apple GPU). Install from https://ollama.com, run
# `ollama pull qwen2.5:3b`, then:
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# Option C: a free cloud API (needs a free account and an API key).
# Pick a model name from the provider's current model list.
# Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1
# Google Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=...
# LLM_API_KEY=...
# Do not send confidential or personal data to a cloud service without permission.

# ---------------------------------------------------------------------------
# Map: the AI reads place names (City / Country fields) and OpenStreetMap
# (Nominatim) finds their coordinates. Only the place names are sent, never the
# document. Set GEOCODER=none to switch this off (projects then have no map points).
# ---------------------------------------------------------------------------
GEOCODER=nominatim

LLM_TIMEOUT_SECONDS=300
MAX_DOCUMENT_CHARS=12000

# ---------------------------------------------------------------------------
# Database - SQLite file by default. Any SQLAlchemy URL works,
# e.g. postgresql+psycopg://user:pass@db:5432/knowledge (add psycopg to requirements)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/knowledge.db
